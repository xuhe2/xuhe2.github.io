---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "徐赫的个人主页" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f0eee8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#content">跳到主要内容</a>
    <main id="content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --page: #f0eee8;
    --paper: #f8f6f0;
    --ink: #171714;
    --secondary: #626159;
    --tertiary: #8c8a80;
    --line: rgba(23, 23, 20, 0.2);
    --blue: #2447f9;
    --blue-dark: #1630c9;
    --signal: #ff4d24;
    --max-width: 1180px;
    --page-padding: clamp(20px, 4vw, 44px);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family:
      "Helvetica Neue", Helvetica, Arial,
      "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 16px;
    color: var(--ink);
    background: var(--page);
    scroll-behavior: smooth;
    scroll-padding-top: 88px;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    line-height: 1.55;
    overflow-x: hidden;
    background: var(--page);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  main {
    min-height: 100vh;
  }

  a {
    color: var(--blue);
    text-decoration: none;
    text-underline-offset: 0.18em;
  }

  a:hover {
    text-decoration: underline;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid rgba(36, 71, 249, 0.32);
    outline-offset: 3px;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  p {
    color: var(--secondary);
  }

  ::selection {
    color: #ffffff;
    background: var(--blue);
  }

  .skip-link {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 100;
    padding: 9px 14px;
    border-radius: 999px;
    color: #fff;
    background: var(--blue);
    transform: translateY(-160%);
    transition: transform 160ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (max-width: 760px) {
    :root {
      --page-padding: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
    }
  }

</style>
