---
import Layout from "../layouts/Layout.astro";
import {
  awards,
  education,
  experience,
  links,
  openSource,
  principles,
  profile,
  research,
  skills,
} from "../data/profile";

const pageTitle = `${profile.name} (${profile.englishName}) — ${profile.role}`;
const description = `${profile.name}的个人主页，关注 Audio 相关方向、AI 系统与软件工程。`;
const waveform = [
  18, 26, 38, 58, 84, 48, 72, 112, 66, 42, 92, 138, 74, 52, 118, 162, 94, 60, 128,
  78, 46, 98, 142, 70, 44, 82, 116, 64, 36, 54, 76,
];
---

<Layout title={pageTitle} description={description}>
  <header class="masthead">
    <div class="masthead-inner">
      <a class="monogram" href="#top" aria-label={`${profile.name} 首页`}>XH</a>
      <p><strong>{profile.englishName}</strong><span>Personal index · 2026</span></p>
      <nav aria-label="主要导航">
        <a href="#experience"><span>01</span>经历</a>
        <a href="#work"><span>02</span>工作</a>
        <a href="#about"><span>03</span>关于</a>
      </nav>
      <a class="header-mail" href={`mailto:${profile.email}`}>Email ↗</a>
    </div>
  </header>

  <div class="page-shell" id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-meta">
        <p><span class="signal-dot"></span>Available for conversation</p>
        <p>{profile.role}</p>
        <p>{profile.location} · UTC+8</p>
      </div>

      <div class="hero-name">
        <h1 id="hero-title"><span>Xu</span> <span>He</span><i>.</i></h1>
        <p>徐赫</p>
      </div>

      <div class="hero-lower">
        <div class="hero-statement">
          <span>Position / 位置</span>
          <h2>研究声音，<br />构建系统。</h2>
        </div>
        <div class="hero-bio">
          <span>Profile / 简介</span>
          <p>{profile.intro}</p>
          <div class="hero-links">
            <a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a>
            <a href={profile.blog} target="_blank" rel="noreferrer">Writing ↗</a>
          </div>
        </div>
        <article class="focus-block">
          <div>
            <span>Recently exploring</span>
            <strong>Audio<br />Exploration</strong>
          </div>
          <div class="mini-wave" aria-hidden="true">
            {waveform.slice(5, 26).map((height, index) => <i style={`--bar:${height / 2}px;--delay:${index * -45}ms`}></i>)}
          </div>
          <span class="focus-note">Ongoing / 暂无公开链接</span>
        </article>
      </div>
    </section>

    <div class="direction-bar" aria-label="关注方向">
      <span>Current directions</span>
      <div>
        {principles.map((item, index) => <p><i>{String(index + 1).padStart(2, "0")}</i>{item}</p>)}
      </div>
    </div>

    <section class="index-section" id="experience" aria-labelledby="experience-title">
      <header class="section-heading">
        <span class="section-number">01</span>
        <div>
          <p>Experience / 经历</p>
          <h2 id="experience-title">工程实践</h2>
        </div>
        <p>在真实业务里处理复杂链路、模型不确定性与系统稳定性，让 AI 能力可靠地落到产品中。</p>
      </header>

      {
        experience.map((item) => (
          <article class="experience-entry">
            <div class="experience-side">
              <span>{item.status}</span>
              <time>{item.time}</time>
              <p>{item.location} / CN</p>
            </div>
            <div class="experience-main">
              <p>{item.company} · TikTok Product Infra</p>
              <h3>{item.role}</h3>
              <p class="experience-summary">{item.summary}</p>
              <ul aria-label="实习关键词">
                {item.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
            <div class="company-type" aria-hidden="true">
              <span>BYTE</span>
              <span>DANCE</span>
            </div>
          </article>
        ))
      }
    </section>

    <section class="index-section" id="work" aria-labelledby="work-title">
      <header class="section-heading">
        <span class="section-number">02</span>
        <div>
          <p>Selected work / 精选工作</p>
          <h2 id="work-title">研究与项目</h2>
        </div>
        <p>我关注信号如何被准确地表达，也关心研究如何成为可靠、可复现、能真正运行的系统。</p>
      </header>

      <a class="audio-project" href={research[0].href} target="_blank" rel="noreferrer">
        <div class="project-index">
          <span>R—01</span>
          <span>2024—NOW</span>
        </div>
        <div class="project-main">
          <p>{research[0].time}</p>
          <h3>{research[0].title}</h3>
          <span class="project-paper">{research[0].paper}</span>
          <strong>{research[0].result}</strong>
        </div>
        <div class="audio-mark" aria-hidden="true">
          <span>AC</span>
          <div class="large-wave">
            {waveform.map((height, index) => <i style={`--bar:${height}px;--delay:${index * -35}ms`}></i>)}
          </div>
          <small>Audio reconstruction / Signal → Sound</small>
        </div>
        <span class="project-arrow" aria-hidden="true">↗</span>
      </a>

      <a class="research-row" href={research[1].href} target="_blank" rel="noreferrer">
        <span class="row-index">R—02</span>
        <div>
          <p>Computer Vision · 2025</p>
          <h3>{research[1].title}</h3>
        </div>
        <div>
          <p>{research[1].paper}</p>
          <strong>{research[1].result}</strong>
        </div>
        <span aria-hidden="true">↗</span>
      </a>

      <div class="opensource">
        <header>
          <span>Code / 开源</span>
          <a href={profile.github} target="_blank" rel="noreferrer">View GitHub ↗</a>
        </header>
        <div class="opensource-list">
          {
            openSource.map((item, index) => (
              <a href={item.href} target="_blank" rel="noreferrer">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
                <small>{item.meta}</small>
                <i aria-hidden="true">↗</i>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="index-section" id="about" aria-labelledby="about-title">
      <header class="section-heading">
        <span class="section-number">03</span>
        <div>
          <p>About / 关于</p>
          <h2 id="about-title">路径与工具</h2>
        </div>
        <p>从计算机科学走向软件工程，也持续从研究、开源和技术写作中建立自己的方法。</p>
      </header>

      <div class="about-grid">
        <article class="education-panel">
          <header><span>Education</span><span>教育背景</span></header>
          <div>
            {
              education.map((item, index) => (
                <section>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <time>{item.time}</time>
                  <h3>{item.school}</h3>
                  <p>{item.major} · {item.degree}</p>
                  <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>
                </section>
              ))
            }
          </div>
        </article>

        <article class="toolkit-panel">
          <header><span>Toolkit</span><span>常用工具</span></header>
          <div>
            {
              skills.map((item, index) => (
                <section>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <h3>{item.group}</h3>
                  <p>{item.items.join(" · ")}</p>
                </section>
              ))
            }
          </div>
        </article>
      </div>

      <div class="recognition-panel">
        <header><span>Selected recognition</span><span>部分荣誉</span></header>
        <div>
          {
            awards.slice(0, 3).map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <time>{item.time}</time>
                <h3>{item.title}</h3>
                <p>{item.level}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <div class="contact-topline">
        <span>04 / Contact</span>
        <span>Open to ideas, research & collaboration</span>
      </div>
      <h2 id="contact-title">有声音，<br />也有回应。</h2>
      <div class="contact-bottom">
        <p>如果你也在做 Audio、AI 系统，或只是想聊一个有趣的工程问题，欢迎给我写信。</p>
        <a href={`mailto:${profile.email}`}><span>Start a conversation</span><strong>{profile.email}</strong><i aria-hidden="true">↗</i></a>
      </div>
    </section>

    <footer class="footer">
      <span>© {new Date().getFullYear()} {profile.name} / {profile.englishName}</span>
      <div>
        {links.slice(0, 2).map((item) => <a href={item.href} target="_blank" rel="noreferrer">{item.label} ↗</a>)}
      </div>
      <a href="#top">Back to top ↑</a>
    </footer>
  </div>
</Layout>

<style>
  .page-shell,
  .masthead-inner {
    width: min(100%, var(--max-width));
    margin: 0 auto;
  }

  .page-shell {
    padding: 0 var(--page-padding) 34px;
  }

  .masthead {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: var(--page);
  }

  .masthead-inner {
    display: grid;
    grid-template-columns: 68px minmax(170px, 1fr) auto 100px;
    align-items: stretch;
    min-height: 68px;
    padding: 0 var(--page-padding);
  }

  .monogram {
    display: grid;
    width: 68px;
    place-items: center;
    border-right: 1px solid var(--line);
    border-left: 1px solid var(--line);
    color: var(--paper);
    background: var(--ink);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .masthead a:hover,
  .audio-project:hover,
  .research-row:hover,
  .opensource a:hover,
  .contact a:hover,
  .footer a:hover {
    text-decoration: none;
  }

  .masthead-inner > p {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 20px;
    color: var(--ink);
    line-height: 1.25;
  }

  .masthead-inner > p strong {
    font-size: 0.78rem;
  }

  .masthead-inner > p span,
  .hero-meta,
  .hero-lower > div > span,
  .focus-block > div > span,
  .direction-bar > span,
  .section-heading p,
  .section-number,
  .project-index,
  .project-main > p,
  .research-row > span,
  .research-row > div > p:first-child,
  .opensource header,
  .experience-side,
  .experience-main > p:first-child,
  .about-grid header,
  .recognition-panel > header,
  .contact-topline,
  .footer {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    letter-spacing: 0.02em;
  }

  .masthead-inner > p span {
    color: var(--tertiary);
    font-size: 0.6rem;
    text-transform: uppercase;
  }

  .masthead nav {
    display: flex;
    align-items: stretch;
  }

  .masthead nav a {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 18px;
    border-left: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.72rem;
  }

  .masthead nav a:last-child {
    border-right: 1px solid var(--line);
  }

  .masthead nav a span {
    color: var(--tertiary);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.54rem;
  }

  .masthead nav a:hover {
    color: #fff;
    background: var(--blue);
  }

  .header-mail {
    display: grid;
    place-items: center;
    color: var(--blue);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .hero {
    min-height: calc(100svh - 68px);
    border-right: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .hero-meta {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    padding: 16px 22px;
    border-bottom: 1px solid var(--line);
    color: var(--secondary);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .hero-meta p {
    display: flex;
    align-items: center;
    gap: 9px;
    color: inherit;
  }

  .signal-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px rgba(255, 77, 36, 0.12);
  }

  .hero-name {
    position: relative;
    display: flex;
    min-height: clamp(260px, 39vw, 450px);
    align-items: center;
    padding: 10px clamp(22px, 4vw, 52px) 20px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero-name::after {
    position: absolute;
    right: clamp(22px, 4vw, 52px);
    bottom: 0;
    left: clamp(22px, 4vw, 52px);
    height: 5px;
    content: "";
    background: linear-gradient(90deg, var(--blue) 0 72%, var(--signal) 72% 77%, var(--ink) 77%);
  }

  .hero-name h1 {
    color: var(--ink);
    font-size: clamp(7.8rem, 18.5vw, 13.7rem);
    font-weight: 700;
    line-height: 0.72;
    letter-spacing: -0.09em;
    white-space: nowrap;
    animation: title-in 750ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-name h1 i {
    color: var(--blue);
    font-style: normal;
  }

  .hero-name > p {
    position: absolute;
    top: 28px;
    right: clamp(22px, 4vw, 52px);
    padding: 7px 10px;
    color: var(--paper);
    background: var(--ink);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .hero-lower {
    display: grid;
    grid-template-columns: 0.8fr 1fr 0.92fr;
    min-height: 270px;
  }

  .hero-lower > div,
  .focus-block {
    padding: clamp(24px, 3.2vw, 38px);
  }

  .hero-lower > div {
    border-right: 1px solid var(--line);
  }

  .hero-lower > div > span,
  .focus-block > div > span {
    color: var(--tertiary);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .hero-statement h2 {
    margin-top: 42px;
    font-size: clamp(1.75rem, 3.2vw, 2.6rem);
  }

  .hero-bio > p {
    margin-top: 38px;
    font-size: 0.9rem;
    line-height: 1.72;
  }

  .hero-links {
    display: flex;
    gap: 22px;
    margin-top: 26px;
  }

  .hero-links a {
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .focus-block {
    position: relative;
    display: flex;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    color: #fff;
    background: var(--blue);
  }

  .focus-block > div > span {
    color: rgba(255, 255, 255, 0.62);
  }

  .focus-block strong {
    display: block;
    margin-top: 6px;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .mini-wave,
  .large-wave {
    display: flex;
    align-items: center;
  }

  .mini-wave {
    gap: 4px;
    height: 66px;
    margin-top: 22px;
  }

  .mini-wave i,
  .large-wave i {
    display: block;
    width: 3px;
    height: var(--bar);
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    animation: signal 1.7s var(--delay) ease-in-out infinite alternate;
  }

  .mini-wave i {
    flex: 1;
    opacity: 0.76;
  }

  .focus-note {
    position: absolute;
    top: 28px;
    right: 28px;
    color: rgba(255, 255, 255, 0.6);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.5rem;
    text-transform: uppercase;
  }

  .direction-bar {
    display: grid;
    grid-template-columns: minmax(170px, 0.45fr) 1fr;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .direction-bar > span {
    padding: 22px;
    border-right: 1px solid var(--line);
    color: var(--tertiary);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .direction-bar > div {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .direction-bar p {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 22px;
    border-right: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .direction-bar p:last-child {
    border-right: 0;
  }

  .direction-bar i {
    color: var(--tertiary);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.55rem;
    font-style: normal;
  }

  .index-section {
    padding-top: clamp(120px, 15vw, 185px);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 70px 1fr minmax(280px, 0.72fr);
    gap: clamp(22px, 4vw, 54px);
    align-items: end;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--ink);
  }

  .section-number {
    color: var(--blue);
    font-size: 0.82rem;
  }

  .section-heading p {
    color: var(--tertiary);
    font-size: 0.58rem;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin-top: 12px;
    font-size: clamp(3rem, 6vw, 5rem);
  }

  .section-heading > p {
    color: var(--secondary);
    text-transform: none;
  }

  .audio-project {
    position: relative;
    display: grid;
    grid-template-columns: 92px minmax(0, 1.05fr) minmax(280px, 0.82fr);
    min-height: 540px;
    color: #fff;
    background: var(--blue);
  }

  .project-index,
  .project-main,
  .audio-mark {
    padding: 32px;
  }

  .project-index {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-right: 1px solid rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.58rem;
    writing-mode: vertical-rl;
  }

  .project-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-main > p {
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .project-main h3 {
    max-width: 560px;
    margin-top: 26px;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    line-height: 1;
  }

  .project-paper {
    max-width: 570px;
    margin-top: 32px;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .project-main strong {
    margin-top: 18px;
    font-size: 0.76rem;
  }

  .audio-mark {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(0, 0, 0, 0.08);
  }

  .audio-mark > span {
    align-self: flex-end;
    font-size: clamp(5rem, 9vw, 8rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.1em;
    opacity: 0.18;
  }

  .large-wave {
    gap: 3px;
    height: 190px;
    margin-top: 26px;
  }

  .large-wave i {
    width: 2px;
    flex: 1;
    opacity: 0.86;
  }

  .audio-mark small {
    margin-top: 28px;
    color: rgba(255, 255, 255, 0.56);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.52rem;
    text-transform: uppercase;
  }

  .project-arrow {
    position: absolute;
    top: 28px;
    right: 30px;
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    transition: color 180ms ease, background 180ms ease;
  }

  .audio-project:hover .project-arrow {
    color: var(--blue);
    background: #fff;
  }

  .research-row {
    display: grid;
    grid-template-columns: 92px minmax(260px, 0.9fr) minmax(280px, 1fr) 30px;
    gap: 30px;
    align-items: center;
    min-height: 190px;
    padding: 30px 32px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
    color: var(--ink);
    transition: color 180ms ease, background 180ms ease;
  }

  .research-row:hover {
    color: #fff;
    background: var(--ink);
  }

  .row-index {
    color: var(--tertiary);
    font-size: 0.58rem;
  }

  .research-row > div > p:first-child {
    color: var(--blue);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .research-row h3 {
    margin-top: 12px;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
  }

  .research-row > div:nth-child(3) p {
    color: var(--secondary);
    font-size: 0.74rem;
    line-height: 1.55;
  }

  .research-row:hover > div:nth-child(3) p {
    color: rgba(255, 255, 255, 0.62);
  }

  .research-row > div:nth-child(3) strong {
    display: block;
    margin-top: 10px;
    font-size: 0.7rem;
  }

  .opensource {
    margin-top: 76px;
    border-top: 1px solid var(--ink);
  }

  .opensource > header,
  .about-grid header,
  .recognition-panel > header {
    display: flex;
    justify-content: space-between;
    padding: 18px 0;
